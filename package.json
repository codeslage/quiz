{
  "name": "project-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.json --output-type err src",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "spellcheck": "cspell --no-progress --dot ."
  },
  "devDependencies": {
    "@cspell/dict-de-de": "4.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "cspell": "10.5.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  }
}
